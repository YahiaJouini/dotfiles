[global]
    # ── Monitor & Focus ───────────────────────────────────────────────────────
    monitor = 0
    follow = keyboard
    layer = overlay

    # ── Geometry (Modern Syntax) ──────────────────────────────────────────────
    # (min_width, max_width) - Prevents tiny boxes while limiting screen takeover
    width = (300, 500)
    # (min_height, max_height) - 0 allows it to shrink to fit the text exactly
    height = (0, 300)
    # (horizontal, vertical) - Precise anchoring
    offset = (24, 24)
    origin = top-right
    
    # ── Padding (UX Balanced) ─────────────────────────────────────────────────
    # Vertical padding is tighter; horizontal is wider for a "ribbon" look
    padding = 12
    horizontal_padding = 20
    text_icon_padding = 16
    icon_position = left
    max_icon_size = 48

    # ── Aesthetics (Abyssal Void) ─────────────────────────────────────────────
    corner_radius = 0
    transparency = 0
    gap_size = 8
    frame_width = 2
    separator_color = frame
    separator_height = 2

    # ── Typography ────────────────────────────────────────────────────────────
    font = JetBrains Mono 10
    line_height = 4 # Improves readability of multi-line logs
    markup = full
    # Summary (Bold) + Body. Scannability is prioritized.
    format = "<b>%s</b>\n%b"
    alignment = left
    vertical_alignment = center

    # ── Workflow & UX Logic ───────────────────────────────────────────────────
    sort = yes
    stack_duplicates = true
    hide_duplicate_count = false
    show_indicators = no
    
    # Mouse interactions for efficiency
    mouse_left_click = close_current
    mouse_middle_click = do_action, close_current
    mouse_right_click = close_all

[urgency_low]
    background = "#16161a" # Anthracite Iron (Surface)
    foreground = "#475569" # Gunmetal Steel (Subtle)
    frame_color = "#475569"
    timeout = 4

[urgency_normal]
    background = "#050506" # Abyssal Void
    foreground = "#f8fafc" # Polished Platinum
    frame_color = "#bf94ff" # Electric Amethyst Highlight
    highlight = "#bf94ff"
    timeout = 8

[urgency_critical]
    background = "#050506" # Abyssal Void
    foreground = "#ff4d4d" # Molten Crimson
    frame_color = "#ff4d4d"
    timeout = 0
