{
    "layer": "top",
    "position": "top",
    "height": 30,
    "margin-top": 0,
    "margin-bottom": 0,

    "modules-left": [
        "custom/power",
        "wlr/taskbar",
        "hyprland/window"
    ],
    "modules-center": [
        "hyprland/workspaces"
    ],
    "modules-right": [
        "mpris",
        "group/tray-expander",
        "network",
        "pulseaudio",
        "clock"
    ],

    "hyprland/window": {
        "format": "{}",
        "max-length": 35,
        "separate-outputs": true,
        "rewrite": {
            "(.*)Mozilla Firefox(.*)": "Firefox",
            "(.*)VSCodium(.*)": "VSCodium",
            "(.*)Alacritty(.*)": "Terminal",
            "(.*)Discord(.*)": "Discord",
            "": "Desktop"
        }
    },

    "hyprland/workspaces": {
        "disable-scroll": true,
        "all-outputs": true,
        "format": "{name}",
        "on-click": "activate"
    },

    "wlr/taskbar": {
        "format": "{icon}",
        "icon-size": 24,
        "on-click": "activate",
        "ignore-list": ["Alacritty"]
    },

    "mpris": {
        "format": "󰎆 {title}",
        "max-length": 25
    },

    "group/tray-expander": {
        "orientation": "inherit",
        "drawer": {
            "transition-duration": 300,
            "children-class": "tray-group-item"
        },
        "modules": ["custom/expand-icon", "tray"]
    },

    "custom/expand-icon": {
        "format": "",
        "tooltip": false
    },

    "network": {
        "family": "ipv4",
        "format-ethernet": "󰈀",
        "format-wifi": " ",
        "format-disconnected": "󰲜 Disconnected",
        "tooltip-format": "{essid} {ipaddr}",
        "on-click": "nm-connection-editor"
    },

    "pulseaudio": {
        "format": "{icon} {volume}%",
        "format-muted": "󰝟",
        "format-icons": { "default": ["󰕾"] }
    },

    "clock": {
        "format": "{:%H:%M | %a %d %b }",
        "tooltip-format": "<tt>{calendar}</tt>"
    },

    "custom/power": {
        "format": "⭘",
        "tooltip":false,
        "on-click": "echo -e 'Logout\nReboot\nShutdown' | rofi -dmenu -p 'System' | xargs -I{} bash -c 'case {} in Logout) swaymsg exit ;; Reboot) reboot ;; Shutdown) poweroff ;; esac'"
    }
}
