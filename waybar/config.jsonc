{
  "layer": "top",
  "position": "top",
  "height": 38,
  "spacing": 4,

  "modules-left": ["custom/power", "sway/workspaces", "wlr/taskbar"],
  "modules-center": ["clock"],
  "modules-right": ["group/tray-expander", "network", "pulseaudio"],

  "custom/power": {
    "format": "⭘",
    "tooltip": false,
    "on-click": "echo -e 'Logout\nReboot\nShutdown' | rofi -dmenu -p 'System' | xargs -I{} bash -c 'case {} in Logout) swaymsg exit ;; Reboot) reboot ;; Shutdown) poweroff ;; esac'"
  },

  "sway/workspaces": {
    "disable-scroll": true,
    "warp-on-scroll": false,
    "format": "{icon}",
    "show-special": false,
    "format-icons": {
      "1": "1",
      "2": "2",
      "3": "3",
      "4": "4",
      "default": "",
    },
    "persistent-workspaces": {
      "HDMI-A-1": [3, 4],
      "DP-1": [1, 2],
    },
  },
  "group/tray-expander": {
    "orientation": "inherit",
    "drawer": {
      "transition-duration": 600,
      "children-class": "tray-group-item",
    },
    "modules": ["custom/expand-icon", "tray"],
  },
  "custom/expand-icon": {
    "format": "",
    "tooltip": false,
  },
  "wlr/taskbar": {
    "format": "{icon}",
    "icon-size": 22,
    "tooltip-format": "{title}",
    "on-click": "activate",
    "on-click-middle": "close",
    "ignore-list": ["Alacritty"],
  },
  "network": {
      "family": "ipv4",
      "format-ethernet": "󰈀  {ipaddr}",
      "format-wifi": "  {ipaddr}",
      "format-disconnected": "󰲜 Disconnected",
      "tooltip-format": "{ifname} via {gwaddr}",
      "on-click": "nm-connection-editor"
  },
  "pulseaudio": {
    "format": "{icon} {volume}%",
    "format-muted": " {volume}%",
    "format-bluetooth": " {volume}%",
    "format-bluetooth-muted": " {volume}%",
    "format-icons": {
      "headphone": " ",
      "headset": " ",
      "default": [" "]
    },
    "on-click": "pavucontrol"
  },
  "tray": {
    "icon-size": 16,
    "spacing": 10
  },
  "clock": {
    "format": "{:%a %d/%m/%Y ~ %H:%M}",
    "tooltip-format": "<span size='15000'><tt>{calendar}</tt></span>",
    "calendar": {
      "mode": "month",
      "format": {
        "months": "<span color='#F5C2E7'><b>{}</b></span>",
        "weekdays": "<span color='#89B4FA'><b>{}</b></span>",
        "days": "<span color='#CDD6F4'><b>{}</b></span>",
        "today": "<span color='#F9E2AF'><b>{}</b></span>",
      },
    },
  },
}
