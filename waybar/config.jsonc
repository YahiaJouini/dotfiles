{
    "layer": "top",
    "position": "top",
    "height": 30,
    "margin-top": 0,
    "margin-bottom": 0,

    "modules-left": [
        "custom/power",
        "wlr/taskbar",
        "hyprland/window"
    ],
    "modules-center": [
        "hyprland/workspaces"
    ],
    "modules-right": [
        "mpris",
        "group/tray-expander",
        "network",
        "pulseaudio",
        "clock",
    ],

    "hyprland/window": {
        "format": "{}",
        "max-length": 35,
        "separate-outputs": true,
        "rewrite": {
            "(.*)Mozilla Firefox(.*)": "Firefox",
            "(.*)VSCodium(.*)": "VSCodium",
            "(.*)Alacritty(.*)": "Terminal",
            "(.*)Discord(.*)": "Discord",
            "": "Desktop"
        }
    },

    "hyprland/workspaces": {
        "disable-scroll": false,
        "all-outputs": true,
        "format": "{name}",
        "on-click": "activate"
    },

    "wlr/taskbar": {
        "format": "{icon}",
        "icon-size": 24,
        "on-click": "activate",
        "ignore-list": ["Alacritty"]
    },

    "mpris": {
        "format": "󰎆 {title}",
        "max-length": 25
    },

    "group/tray-expander": {
        "orientation": "inherit",
        "drawer": {
            "transition-duration": 300,
            "children-class": "tray-group-item"
        },
        "modules": ["custom/expand-icon", "tray"]
    },

    "custom/expand-icon": {
        "format": "",
        "tooltip": false
    },

    "network": {
        "family": "ipv4",
        "format-ethernet": "󰈀",
        "format-wifi": " ",
        "format-disconnected": "󰲜 Disconnected",
        "tooltip-format": "{essid} {ipaddr}",
        "on-click": "nm-connection-editor"
    },
    "pulseaudio": {
        "format": "{icon} {volume}%",
        "format-muted": "󰝟",
        "format-icons": {
            "headphone": "",
            "default": ["", "", ""]
        },
        "on-click": "~/.config/scripts/sys-audio-mixer.sh",
        "on-click-middle": "~/.config/scripts/sys-audio-switch.sh",
        "on-click-right": "pavucontrol",
        "on-scroll-up": "wpctl set-volume @DEFAULT_AUDIO_SINK@ 5%+",
        "on-scroll-down": "wpctl set-volume @DEFAULT_AUDIO_SINK@ 5%-"
    },
    "clock": {
            "format": "{:%H:%M | %a %d %b}",
            "tooltip-format": "<span size='15000'><tt>{calendar}</tt></span>",
            "on-click": "swaync-client -t -sw",
            "calendar": {
                "mode-mon-col"  : 3,
                "weeks-pos"     : "right",
                "on-scroll"     : 1,
            "format": {
                "months": "<span color='#F5C2E7'><b>{}</b></span>",
                "weekdays": "<span color='#89B4FA'><b>{}</b></span>",
                "days": "<span color='#CDD6F4'><b>{}</b></span>",
                "today": "<span color='#F9E2AF'><b>{}</b></span>",
              }
            }
        },
    "custom/power": {
        "format": "⭘",
        "tooltip": false,
        "on-click": "~/.config/scripts/sys-power.sh"
    }
}
