set $mod Mod4
set $terminal kitty
set $fileManager dolphin
set $menu rofi -show drun
set $scriptsDir ~/.config/scripts

input * {
    xkb_layout "fr"
}

input type:keyboard {
      xkb_numlock enabled
}

output HDMI-A-1 mode 1920x1080@75.001Hz position 0 0
output DP-1 mode 1920x1080@143.855Hz position 1920 0

gaps inner 8
gaps outer 5

default_border pixel 2
default_floating_border pixel 2

for_window [title=".*"] border pixel 2

# class                 border  backgr. text    indicator child_border
client.focused          #cdd6f4 #cdd6f4 #1e1e2e #cdd6f4   #cdd6f4
client.focused_inactive #595959 #595959 #cdd6f4 #595959   #595959
client.unfocused        #595959 #595959 #cdd6f4 #595959   #595959
client.urgent           #f38ba8 #f38ba8 #11111b #f38ba8   #f38ba8

# Volume and Brightness
bindsym XF86AudioRaiseVolume exec wpctl set-volume -l 1 @DEFAULT_AUDIO_SINK@ 5%+
bindsym XF86AudioLowerVolume exec wpctl set-volume @DEFAULT_AUDIO_SINK@ 5%-
bindsym XF86AudioMute exec wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle
bindsym XF86AudioMicMute exec wpctl set-mute @DEFAULT_AUDIO_SOURCE@ toggle
bindsym XF86MonBrightnessUp exec brightnessctl -e4 -n2 set 5%+
bindsym XF86MonBrightnessDown exec brightnessctl -e4 -n2 set 5%-

# Media Player
bindsym XF86AudioNext exec playerctl next
bindsym XF86AudioPause exec playerctl play-pause
bindsym XF86AudioPlay exec playerctl play-pause
bindsym XF86AudioPrev exec playerctl previous

bindsym $mod+Return exec $terminal
bindsym $mod+q kill
bindsym $mod+e exec $fileManager
bindsym $mod+c floating toggle
bindsym $mod+space exec $menu
bindsym $mod+p layout toggle split
bindsym $mod+j layout toggle split
bindsym $mod+f fullscreen toggle
bindsym $mod+l exec wlogout -b 5

# Clipboard & Screenshots
bindsym $mod+v exec pkill -x rofi || $scriptsDir/cliphist.sh -c
bindsym $mod+Shift+v exec cliphist wipe
bindsym $mod+s exec grim -g "$(slurp)" - | wl-copy
bindsym $mod+Shift+s exec grim -g "$(slurp)" ~/Pictures/Screenshots/$(date +'%s_grim.png')

# Scripts
bindsym $mod+w exec $scriptsDir/wallpaper.sh
bindsym $mod+t exec $scriptsDir/wlsunset-toggle.sh
bindsym $mod+r exec ~/.config/waybar/scripts/launch.sh

bindsym $mod+Left focus left
bindsym $mod+Right focus right
bindsym $mod+Up focus up
bindsym $mod+Down focus down

bindsym $mod+Shift+Left move left
bindsym $mod+Shift+Right move right
bindsym $mod+Shift+Up move up
bindsym $mod+Shift+Down move down

bindsym $mod+Control+Right resize grow right 50 px; resize shrink left 50 px
bindsym $mod+Control+Left  resize shrink right 50 px; resize grow left 50 px
bindsym $mod+Control+Up    resize shrink down 50 px; resize grow up 50 px
bindsym $mod+Control+Down  resize grow down 50 px; resize shrink up 50 px

bindcode $mod+10 workspace number 1
bindcode $mod+11 workspace number 2
bindcode $mod+12 workspace number 3
bindcode $mod+13 workspace number 4

bindcode $mod+Shift+10 move container to workspace number 1
bindcode $mod+Shift+11 move container to workspace number 2
bindcode $mod+Shift+12 move container to workspace number 3
bindcode $mod+Shift+13 move container to workspace number 4

bindsym $mod+button5 workspace next_on_output
bindsym $mod+button4 workspace prev_on_output

exec_always dbus-update-activation-environment --systemd WAYLAND_DISPLAY XDG_CURRENT_DESKTOP=sway
exec systemctl --user import-environment WAYLAND_DISPLAY XDG_CURRENT_DESKTOP

# KDE Polkit
exec /usr/libexec/kf6/polkit-kde-authentication-agent-1

# Launch Waybar
exec ~/.config/waybar/scripts/launch.sh
